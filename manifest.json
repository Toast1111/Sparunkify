{
  "manifest_version": 3,
  "name": "Sparunkify",
  "version": "0.3.3",
  "minimum_chrome_version": "116",
  "description": "Reflective album artwork and an optional music-reactive Maxwell cat for Spotify and YouTube Music.",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://i.scdn.co/*",
    "https://mosaic.scdn.co/*",
    "https://music.youtube.com/*",
    "https://lh3.googleusercontent.com/*",
    "https://yt3.googleusercontent.com/*",
    "https://yt3.ggpht.com/*",
    "https://i.ytimg.com/*",
    "https://img.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sparunkify",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "players.js",
        "artwork.js",
        "engine.js",
        "assets/maxwell/mesh.js",
        "maxwell-renderer.js",
        "maxwell-audio.js",
        "maxwell-cat.js",
        "spotify-theme.js",
        "surface.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "web_accessible_resources": [{"resources":["assets/maxwell/dingus_nowhiskers.jpg","assets/maxwell/dingus_whiskers.tga.png"],"matches":["https://open.spotify.com/*","https://music.youtube.com/*"]}],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
